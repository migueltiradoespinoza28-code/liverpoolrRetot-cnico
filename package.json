{
  "name": "liverpool-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Framework E2E (Playwright + TS) para el flujo de búsqueda de Liverpool con validación cruzada UI vs red",
  "scripts": {
    "test": "playwright test --project=unit --project=chromium --grep-invert @bonus",
    "test:headed": "playwright test --project=chromium --grep-invert @bonus --headed",
    "test:unit": "playwright test --project=unit",
    "test:all-scenarios": "cross-env ALL_SCENARIOS=1 playwright test --project=chromium --grep-invert @bonus",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --grep-invert @bonus",
    "test:bonus": "playwright test --project=chromium --grep @bonus",
    "test:visual:update": "playwright test --project=chromium --grep @visual --update-snapshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.0"
  }
}
